{
  "version": 1,
  "platforms": {
    "iosxe": {
      "portfast": "spanning-tree portfast edge",
      "bpduguard_default": "spanning-tree portfast edge bpduguard default",
      "ntp_algorithm": "hmac-sha2-256",
      "ssh_encryption": "aes256-gcm aes256-ctr",
      "ssh_mac": "hmac-sha2-512 hmac-sha2-256",
      "ssh_kex": "ecdh-sha2-nistp384 ecdh-sha2-nistp256",
      "boot_image": "flash:packages.conf",
      "redundancy_sso": true,
      "device_tracking": null
    },
    "ios": {
      "portfast": "spanning-tree portfast",
      "bpduguard_default": "spanning-tree portfast bpduguard default",
      "ntp_algorithm": "md5",
      "ssh_encryption": "aes256-ctr aes192-ctr aes128-ctr",
      "ssh_mac": "hmac-sha2-512 hmac-sha2-256",
      "ssh_kex": null,
      "boot_image": "flash:<REPLACE-ME:image-file>",
      "redundancy_sso": false,
      "device_tracking": "ip device tracking probe delay 10"
    }
  }
}
